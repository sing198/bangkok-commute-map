# PostgreSQL + PostGIS
POSTGRES_USER=commute
POSTGRES_PASSWORD=commute_dev
POSTGRES_DB=bangkok_commute
DATABASE_URL=postgres://commute:commute_dev@localhost:5432/bangkok_commute?sslmode=disable

# Redis (local or cloud REDIS_URL e.g. Upstash rediss://...)
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Backend API
API_PORT=8081
GIN_MODE=debug
SEED_ON_START=false
CORS_ALLOW_ORIGIN=http://localhost:5173
